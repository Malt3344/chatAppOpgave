doctype html
html(lang="en")
    body 
        link(rel="stylesheet", href="/style.css")
        script(src="/functions.js" defer) 

        div(class="usersHeader")
            h1(class="alleBruger") Alle bruger
            div(class="usersActions")
                a(href="/users/addUser", class="opretBruger") Opret Bruger
                a(href="/", class="tilbage") Tilbage
        br
        each u in users 
            div(class="userRow")
                p(class="users")= u.username    
                button(type="button" class="deleteUser" data-user-id=u.id) Slet