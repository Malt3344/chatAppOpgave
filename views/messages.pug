doctype html 
html 
    head 
        title Mine beskeder 
        link(rel="stylesheet", href="/style.css")
    body
        div(class="overskrift")
            h1 Mine beskeder 
            a(href="/" class="tilbage") Tilbage 

        each message in messages 
            div(class="messageText")
                p(class="messageOwner")=message.username 
                p= message.message
        else 
            p Du har ingen beskeder endnu