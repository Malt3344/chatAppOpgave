doctype html
html
    head
        title= chat.name
        link(rel="stylesheet", href="/style.css")
    body
        div(class="overskrift")
            h1= chat.name
            a(href="/" class="tilbage") Tilbage

        each m in chat.messages
            div(class="messageText")
                p(class="messageOwner")= m.owner 
                p= m.message