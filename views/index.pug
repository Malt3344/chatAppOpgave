html
    head
        title Chat App
        link(rel="stylesheet", href="/style.css")
        script(src="/functions.js" defer)
    body
        if(isValidUser)
            p Logget ind som #{username} (niveau #{level})
            div#knapper
                a.btn.blue(href="/logout") Log ud
                a.btn.blue(href="/chats/new") Opret chat
                a.btn.blue(href="/chats") Gå til chats
                if (level === 3)
                    a.btn.blue(href="/users") Alle brugere
            h2 Dine chats
            include snippets/chatOversigt.pug
        else
            h1(class="welcome") Velkommen til din chat
            include snippets/loginForm.pug
